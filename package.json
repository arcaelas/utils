{
  "license": "MIT",
  "version": "2.0.8",
  "name": "@arcaelas/utils",
  "homepage": "https://github.com/arcaelas/utils",
  "description": "A small box of tools, which are implemented in different factions of the library.",
  "keywords": [
    "utils",
    "tools",
    "arcaelas",
    "arcaelas insiders",
    "arcaelas-insiders",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arcaelas/utils.git"
  },
  "bugs": {
    "email": "community@arcaelas.com",
    "url": "https://github.com/arcaelas/utils/issues"
  },
  "main": "./build/cjs/index.js",
  "files": [
    "build"
  ],
  "author": {
    "name": "Arcaelas Insiders",
    "email": "comunity@arcaelas.com",
    "url": "https://github.com/arcaelas"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf build && tsc --module commonjs --moduleResolution node --outDir build/cjs && tsc-alias --outDir build/cjs && echo '{\"type\":\"commonjs\"}' > build/cjs/package.json && tsc --module ESNext --moduleResolution bundler --outDir build/esm && tsc-alias --resolve-full-paths --outDir build/esm && echo '{\"type\":\"module\"}' > build/esm/package.json",
    "docs": "mkdocs gh-deploy --force",
    "release": "npm publish --access public",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.0.0"
  },
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  }
}
